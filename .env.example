# Copie para .env e preencha. O .env real nunca vai para o git.
# Fora do Docker o Spring le este arquivo sozinho (spring.config.import no application.yaml).
# No Docker o docker-compose le este arquivo e troca DB_HOST pelo container do Postgres.
# Gere segredos com: openssl rand -base64 48

# BANCO DE DADOS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinela
DB_USERNAME=postgres
# Obrigatorio no Docker: o compose nao sobe o Postgres sem senha.
DB_PASSWORD=
# update em desenvolvimento; em producao use validate e aplique o schema por migracao (Flyway).
JPA_DDL_AUTO=update

# JWT
# Minimo 32 caracteres; a aplicacao recusa subir com segredo fraco.
SENTINELA_JWT_SECRET=

# E-MAIL (SMTP)
# No Gmail use uma senha de app, nao a senha da conta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=
MAIL_ENABLED=true

# GOOGLE OAUTH
# So o client id: o backend valida o ID token, nao usa client secret.
GOOGLE_CLIENT_ID=

# WEATHER API
WEATHER_API_KEY=

# SERVIDOR
SERVER_PORT=8080
SPRINGDOC_ENABLED=true
APP_TIME_ZONE=America/Sao_Paulo
# URL publica do front usada nos links de convite da equipe.
FRONTEND_URL=http://localhost

# FRONT NO DOCKER (servico web do compose; fora do Docker o front usa web/.env.local)
# Porta do site. O Google Client ID do front e o mesmo GOOGLE_CLIENT_ID acima.
WEB_PORT=80
VITE_LEGAL_COMPANY=Sentinela
VITE_LEGAL_CONTACT_EMAIL=privacidade@sentinela.com.br

# Copernicus Sentinel Hub (server-side credentials; optional)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Asaas (pagamentos). Sandbox: https://api-sandbox.asaas.com/v3 | Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token do webhook: 32 a 255 caracteres, sem espacos, diferente da chave de API
ASAAS_WEBHOOK_TOKEN=
