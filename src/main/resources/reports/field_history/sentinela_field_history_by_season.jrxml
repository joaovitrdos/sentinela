<!-- JasperReports Library 7.x; SQL and authorization remain in this template. -->
<jasperReport whenNoDataType="NoDataSection" name="sentinela_field_history_by_season" language="java" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="794"
              leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24"
              uuid="74be80d0-f046-40ca-b42d-1e0a93c3807c">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="TIME_LABEL" class="java.lang.String"/>
    <parameter name="OWNER_ID" class="java.lang.String"/>
    <parameter name="ALL_PROPERTIES" class="java.lang.Boolean"/>
    <parameter name="PROPERTY_IDS" class="java.util.Collection"/>
    <parameter name="FROM_DATE" class="java.sql.Date"/>
    <parameter name="TO_DATE" class="java.sql.Date"/>
    <parameter name="FROM_TIME" class="java.sql.Time"/>
    <parameter name="TO_TIME" class="java.sql.Time"/>
    <query language="sql"><![CDATA[
WITH visible_properties AS (
    SELECT p.property_id, p.name
    FROM tb_property p
    WHERE (p.user_id = CAST($P{OWNER_ID} AS uuid)
        OR (p.team_enabled = true AND EXISTS (
            SELECT 1 FROM tb_property_member m
            WHERE m.property_id = p.property_id AND m.user_id = CAST($P{OWNER_ID} AS uuid)
        )))
      AND ($P{ALL_PROPERTIES} = true OR $X{IN, p.property_id, PROPERTY_IDS})
), events AS (
    SELECT s.planting_date AS event_date, NULL::time AS event_time,
           p.name::text AS property_name, pl.name::text AS plot_name,
           concat_ws(' / ', s.crop_name, nullif(s.variety, ''))::text AS season_name,
           'Início de Safra'::text AS record_type, NULL::text AS responsible_name,
           'Registrada'::text AS status_name,
           ('Plantio: ' || to_char(s.planting_date, 'DD/MM/YYYY'))::text AS detail
    FROM tb_plot_season s
    JOIN tb_plot pl ON pl.plot_id = s.plot_id
    JOIN visible_properties p ON p.property_id = pl.property_id
    UNION ALL
    SELECT s.harvest_date, NULL::time, p.name::text, pl.name::text,
           concat_ws(' / ', s.crop_name, nullif(s.variety, ''))::text,
           'Encerramento de Safra'::text, NULL::text, 'Concluída'::text,
           ('Colheita: ' || to_char(s.harvest_date, 'DD/MM/YYYY'))::text
    FROM tb_plot_season s
    JOIN tb_plot pl ON pl.plot_id = s.plot_id
    JOIN visible_properties p ON p.property_id = pl.property_id
    WHERE s.harvest_date IS NOT NULL
    UNION ALL
    SELECT a.activity_date, a.activity_time, p.name::text,
           COALESCE(pl.name, 'Propriedade')::text,
           concat_ws(' / ', s.crop_name, nullif(s.variety, ''))::text,
           (CASE a.activity_type
               WHEN 'PLANTING' THEN 'Plantio'
               WHEN 'FERTILIZATION' THEN 'Adubação'
               WHEN 'SPRAYING' THEN 'Aplicação'
               WHEN 'HARVEST' THEN 'Colheita'
               WHEN 'IRRIGATION' THEN 'Irrigação'
               WHEN 'RAINFALL' THEN 'Chuva'
               WHEN 'INSPECTION' THEN 'Vistoria'
               WHEN 'INCIDENT' THEN 'Ocorrência'
               ELSE 'Outra Operação'
           END)::text,
           COALESCE(a.responsible_name, u.name, 'Não Informado')::text,
           'Registrada'::text,
           concat_ws(' | ', nullif(a.notes, ''),
               CASE WHEN a.input_name IS NOT NULL THEN concat('Insumo: ', a.input_name, ' ', a.input_quantity, ' ', a.input_unit) END,
               CASE WHEN a.harvest_quantity IS NOT NULL THEN concat('Colheita: ', a.harvest_quantity, ' ', a.harvest_unit) END,
               CASE WHEN ph.photo_count > 0 THEN concat('Fotos: ', ph.photo_count) END
           )::text
    FROM tb_property_activity a
    JOIN visible_properties p ON p.property_id = a.property_id
    LEFT JOIN tb_plot pl ON pl.plot_id = a.plot_id
    LEFT JOIN tb_plot_season s ON s.season_id = a.season_id
    LEFT JOIN tb_users u ON u.user_id = a.responsible_user_id
    LEFT JOIN LATERAL (
        SELECT count(*) AS photo_count FROM tb_activity_photo photo WHERE photo.activity_id = a.activity_id
    ) ph ON true
    UNION ALL
    SELECT a.due_date, NULL::time, p.name::text,
           COALESCE(pl.name, 'Propriedade')::text, NULL::text,
           (CASE a.kind WHEN 'IRRIGATION' THEN 'Ação de Irrigação' ELSE 'Ação de Vistoria' END)::text,
           a.responsible_name::text,
           (CASE a.status WHEN 'DONE' THEN 'Concluída' ELSE 'Aberta' END)::text,
           concat_ws(' | ', nullif(a.title, ''), nullif(a.source_note, ''),
               CASE WHEN a.completed_at IS NOT NULL
                   THEN concat('Executada em ', to_char(a.completed_at, 'DD/MM/YYYY HH24:MI'),
                       ' por ', COALESCE(done.name, 'usuário'),
                       ': ', COALESCE(a.completion_note, '')) END
           )::text
    FROM tb_field_action a
    JOIN visible_properties p ON p.property_id = a.property_id
    LEFT JOIN tb_plot pl ON pl.plot_id = a.plot_id
    LEFT JOIN tb_users done ON done.user_id = a.completed_by_user_id
)
SELECT e.event_date, e.property_name, e.plot_name, e.season_name, e.record_type,
       e.responsible_name, e.status_name, e.detail
FROM events e
WHERE e.event_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE}
  AND (CAST($P{FROM_TIME} AS time) IS NULL OR e.event_time IS NULL
       OR e.event_time BETWEEN $P{FROM_TIME} AND $P{TO_TIME})
ORDER BY e.event_date, e.property_name, e.plot_name, e.record_type
    ]]></query>
    <field name="event_date" class="java.sql.Date"/>
    <field name="property_name" class="java.lang.String"/>
    <field name="plot_name" class="java.lang.String"/>
    <field name="season_name" class="java.lang.String"/>
    <field name="record_type" class="java.lang.String"/>
    <field name="responsible_name" class="java.lang.String"/>
    <field name="status_name" class="java.lang.String"/>
    <field name="detail" class="java.lang.String"/>
