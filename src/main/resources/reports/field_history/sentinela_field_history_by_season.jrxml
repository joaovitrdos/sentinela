        <element kind="staticText" uuid="00000000-0000-4000-8000-000000000008" x="608" y="0" width="186" height="30" mode="Opaque" backcolor="#D2D2D7" forecolor="#000000" bold="true" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Detalhe]]></text><box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#A7ADB3"/></box></element>
    </columnHeader>
    <detail>
        <band height="34" splitType="Stretch">
