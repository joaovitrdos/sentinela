            <element kind="textField" uuid="00000000-0000-4000-8000-000000000010" x="64" y="0" width="108" height="34" fontSize="7.4" blankWhenNull="true" textAdjust="StretchHeight" stretchType="ContainerHeight" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[br.com.sentinela.util.Util.capitalizeWords($F{property_name})]]></expression><box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#A7ADB3"/></box></element>
