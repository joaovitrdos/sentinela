<!-- Created for JasperReports Library 7.x. Edit with Jaspersoft Studio 7 or newer. -->
<jasperReport whenNoDataType="NoDataSection" name="sentinela_activity_summary_by_property" language="java" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="794"
              leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24"
              uuid="f6e73a8c-6277-4d14-9d19-2f664b1e3262">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="TIME_LABEL" class="java.lang.String"/>
    <parameter name="OWNER_ID" class="java.lang.String"/>
    <parameter name="ALL_PROPERTIES" class="java.lang.Boolean"/>
    <parameter name="PROPERTY_IDS" class="java.util.Collection"/>
    <parameter name="FROM_DATE" class="java.sql.Date"/>
    <parameter name="TO_DATE" class="java.sql.Date"/>
    <parameter name="FROM_TIME" class="java.sql.Time"/>
    <parameter name="TO_TIME" class="java.sql.Time"/>

    <query language="sql"><![CDATA[
        SELECT
            p.name::text AS property_name,
            concat_ws('/', p.city, p.state)::text AS location,
            concat_ws(' / ', nullif(p.crop_name, ''), nullif(p.plot_name, ''))::text AS crop,
            CASE a.activity_type
                WHEN 'IRRIGATION' THEN 'Irrigação'
                WHEN 'RAINFALL' THEN 'Chuva Medida'
                WHEN 'INSPECTION' THEN 'Inspeção'
                WHEN 'INCIDENT' THEN 'Incidente'
                ELSE a.activity_type
            END::text AS activity_type,
            count(*)::bigint AS event_count,
            count(DISTINCT a.activity_date)::bigint AS active_days,
            CASE WHEN a.activity_type = 'IRRIGATION'
                THEN sum(a.amount_mm)::double precision ELSE NULL END AS total_amount_mm,
            CASE WHEN a.activity_type = 'IRRIGATION'
                THEN avg(a.amount_mm)::double precision ELSE NULL END AS average_amount_mm,
            max(a.activity_date) AS last_activity_date
        FROM tb_property_activity a
        JOIN tb_property p ON p.property_id = a.property_id
        WHERE (p.user_id = CAST($P{OWNER_ID} AS uuid) OR
            (p.team_enabled = true AND EXISTS (SELECT 1 FROM tb_property_member m
                WHERE m.property_id = p.property_id AND m.user_id = CAST($P{OWNER_ID} AS uuid))))
            AND ($P{ALL_PROPERTIES} = true OR $X{IN, p.property_id, PROPERTY_IDS})
            AND a.activity_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE}
            AND (CAST($P{FROM_TIME} AS time) IS NULL OR a.activity_time BETWEEN $P{FROM_TIME} AND $P{TO_TIME})
        GROUP BY p.property_id, p.name, p.city, p.state, p.crop_name, p.plot_name, a.activity_type
        ORDER BY p.name, a.activity_type
    ]]></query>

    <field name="property_name" class="java.lang.String"/>
    <field name="location" class="java.lang.String"/>
    <field name="crop" class="java.lang.String"/>
    <field name="activity_type" class="java.lang.String"/>
    <field name="event_count" class="java.lang.Long"/>
    <field name="active_days" class="java.lang.Long"/>
    <field name="total_amount_mm" class="java.lang.Double"/>
    <field name="average_amount_mm" class="java.lang.Double"/>
    <field name="last_activity_date" class="java.sql.Date"/>

