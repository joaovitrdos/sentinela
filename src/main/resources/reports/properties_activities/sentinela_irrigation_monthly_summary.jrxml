        <element kind="textField" uuid="204fba1f-b0fd-44ea-8333-d03294b3f270" x="0" y="39" width="794" height="20" forecolor="#252525" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["Período: " + $P{PERIOD_LABEL} + "   |   Horário: " + $P{TIME_LABEL}]]></expression></element>
