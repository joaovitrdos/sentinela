<!-- Created for JasperReports Library 7.x. Edit with Jaspersoft Studio 7 or newer. -->
<jasperReport whenNoDataType="NoDataSection" name="sentinela_properties_activities" language="java" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="794"
              leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24"
              uuid="01a2cbda-a7e1-4f41-9372-019af115b1dc">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="TIME_LABEL" class="java.lang.String"/>
    <parameter name="OWNER_ID" class="java.lang.String"/>
    <parameter name="ALL_PROPERTIES" class="java.lang.Boolean"/>
    <parameter name="PROPERTY_IDS" class="java.util.Collection"/>
    <parameter name="FROM_DATE" class="java.sql.Date"/>
    <parameter name="TO_DATE" class="java.sql.Date"/>
    <parameter name="FROM_TIME" class="java.sql.Time"/>
    <parameter name="TO_TIME" class="java.sql.Time"/>

    <query language="sql"><![CDATA[
        SELECT report_rows.*
        FROM (
            SELECT
                'Propriedade'::text AS tipo,
                p.property_id::text AS id,
                p.name::text AS propriedade,
                concat_ws('/', p.city, p.state)::text AS localidade,
                concat('Área: ', coalesce(round(p.area_hectares::numeric, 2)::text, ''), ' ha; lat: ',
                    coalesce(round(p.latitude::numeric, 5)::text, ''), '; lon: ', coalesce(round(p.longitude::numeric, 5)::text, ''))::text AS medidas,
                concat_ws(' / ', nullif(p.crop_name, ''), nullif(p.plot_name, ''), nullif(p.crop_stage, ''))::text AS cultura,
                coalesce(to_char(p.planting_date, 'DD/MM/YYYY'), '')::text AS data,
                concat('Cadastro: ', coalesce(to_char(p.created_at, 'DD/MM/YYYY HH24:MI'), ''),
                    '; atualização: ', coalesce(to_char(p.update_at, 'DD/MM/YYYY HH24:MI'), ''))::text AS detalhes,
                p.planting_date AS sort_date
            FROM tb_property p
            WHERE (p.user_id = CAST($P{OWNER_ID} AS uuid) OR
                (p.team_enabled = true AND EXISTS (SELECT 1 FROM tb_property_member m
                    WHERE m.property_id = p.property_id AND m.user_id = CAST($P{OWNER_ID} AS uuid))))
                AND ($P{ALL_PROPERTIES} = true OR $X{IN, p.property_id, PROPERTY_IDS})

            UNION ALL

            SELECT
                (CASE a.activity_type WHEN 'IRRIGATION' THEN 'Irrigação'
                    WHEN 'RAINFALL' THEN 'Chuva Medida'
                    WHEN 'INSPECTION' THEN 'Inspeção' WHEN 'INCIDENT' THEN 'Incidente'
                    ELSE a.activity_type END)::text AS tipo,
                a.activity_id::text AS id,
                p.name::text AS propriedade,
                concat_ws('/', p.city, p.state)::text AS localidade,
                CASE WHEN a.amount_mm IS NULL THEN '' ELSE concat(a.amount_mm::text, ' mm') END::text AS medidas,
                concat_ws(' / ', nullif(coalesce(plot.crop_name, p.crop_name), ''),
                    nullif(coalesce(plot.name, p.plot_name), ''), nullif(coalesce(plot.crop_stage, p.crop_stage), ''))::text AS cultura,
                concat(to_char(a.activity_date, 'DD/MM/YYYY'),
                    CASE WHEN a.activity_time IS NULL THEN '' ELSE concat(' ', to_char(a.activity_time, 'HH24:MI')) END)::text AS data,
                concat(a.notes, '; registro: ', coalesce(to_char(a.created_at, 'DD/MM/YYYY HH24:MI'), ''))::text AS detalhes,
                a.activity_date AS sort_date
            FROM tb_property_activity a
            JOIN tb_property p ON p.property_id = a.property_id
            LEFT JOIN tb_plot plot ON plot.plot_id = a.plot_id
            WHERE (p.user_id = CAST($P{OWNER_ID} AS uuid) OR
                (p.team_enabled = true AND EXISTS (SELECT 1 FROM tb_property_member m
                    WHERE m.property_id = p.property_id AND m.user_id = CAST($P{OWNER_ID} AS uuid))))
                AND ($P{ALL_PROPERTIES} = true OR $X{IN, p.property_id, PROPERTY_IDS})
                AND a.activity_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE}
                AND (CAST($P{FROM_TIME} AS time) IS NULL OR a.activity_time BETWEEN $P{FROM_TIME} AND $P{TO_TIME})
        ) AS report_rows
        ORDER BY report_rows.propriedade, report_rows.sort_date, report_rows.tipo
    ]]></query>

    <field name="tipo" class="java.lang.String"/>
    <field name="id" class="java.lang.String"/>
    <field name="propriedade" class="java.lang.String"/>
    <field name="localidade" class="java.lang.String"/>
    <field name="medidas" class="java.lang.String"/>
    <field name="cultura" class="java.lang.String"/>
    <field name="data" class="java.lang.String"/>
    <field name="detalhes" class="java.lang.String"/>

