# Copie para .env.local e preencha.
# Somente configuracoes publicas: estes valores podem ser vistos no navegador.
# Nunca coloque chaves WeatherAPI, client secrets, senhas ou segredo JWT neste diretorio.
# A lista permitida para o navegador fica em vite.config.ts; o proxy e usado so pelo Vite.

# Prefixo das chamadas ao backend. Em desenvolvimento o Vite repassa /api para o Spring Boot.
VITE_API_URL=/api
VITE_TIME_ZONE=America/Sao_Paulo

# Para onde o proxy do Vite manda o /api em desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:8080

# Client ID do Google (o mesmo GOOGLE_CLIENT_ID do backend). Vazio = botao do Google desabilitado.
VITE_GOOGLE_CLIENT_ID=

# Quem responde pelos dados (aparece na Politica de Privacidade e nos Termos de Uso).
VITE_LEGAL_COMPANY=Sentinela
VITE_LEGAL_CONTACT_EMAIL=privacidade@sentinela.com.br
