# Serve o build do React e repassa /api para o Spring Boot, igual ao proxy do Vite em desenvolvimento:
# /api/auth/login -> http://app:PORTA/auth/login. Mesma origem para o navegador, entao sem CORS.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # DNS interno do Docker: se o container da API for recriado e trocar de IP, o nginx acha de novo.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location /api/ {
        set $api http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A primeira carga do SNIRH (estacoes, rios) pode demorar
        proxy_read_timeout 120s;
    }

    # Arquivos com hash no nome: podem ficar em cache para sempre
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location /geo/ {
        expires 1d;
        try_files $uri =404;
    }

    # Rotas do React Router (/home, /login...) caem no index.html, que nunca fica em cache
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        try_files $uri $uri/ /index.html;
    }
}
